# title: 計算中も表示する(よけるゲーム)
# norom: basic
# 8で上、2で下の道に移り、左から来る岩をよける(40行で画面を消す)。
# 画面の右半分は、130行の掛け算でBASICが待たせている値(A〜F)の点を、表示を
# オンにしたまま見せている。値の仮数の桁の上位4ビットが下の3段、下位4ビットが
# 上の4段の点になる。積む位置(右から8列ずつ)ごとに字の枠の切れ目が違うので、
# 岩の値は位置ごとにT()に用意してある。ほかの行は値を1つまでしか待たせない
# (右の端の8列だけを使う)ので、A〜Fの点は消えない。
10 POKE &C200,2,1,255,177,55
20 DIM T(17):FOR I=0 TO 17:READ T(I):NEXT I:G=.005070705:H=.05070705
30 O=0:I=0:J=0:M=0:N=0:Q=0:L=0:W=1:S=0
40 WAIT 0:PRINT "":CALL &C200
50 K$=INKEY$:IF K$="8" LET L=0:W=1
60 IF K$="2" LET L=1:W=2
70 O=I:I=J:J=M:M=N:N=Q:Q=RND 4:IF Q>2 LET Q=0
80 IF O=W THEN 200
90 V=G:IF L LET V=H
100 A=T(O)+V:B=T(I+3):C=T(J+6):D=T(M+9):E=T(N+12):F=T(Q+15):S=S+1
130 Z=0*(A*(B*(C*(D*(E*(F*1))))))
140 GOTO 50
200 BEEP 3:WAIT:PRINT "SCORE ";S
210 GOTO 30
300 DATA 8,8.0020702,8.020702,8,8.000020702,8.00020702,8,8.0020702,8.020702
310 DATA 8,8.0020702,8.020702,8,8.20702,8.0707,8,8.0020702,8.020702
